{
  "manifest_version": 3,
  "name": "Unscamable AI",
  "version": "1.0",
  "description": "An AI-enhanced browser extension designed to analyze online transaction conversations, extract critical seller information, and generate real‑time risk assessments to help users identify and avoid potential fraud.",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:5000/*",
    "*://messenger.com/*",
    "*://facebook.com/*",
    "*://web.whatsapp.com/*",
    "*://gmail.com/*",
    "*://web.telegram.org/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "icons": {
    "16": "icons/logo-final16.png",
    "32": "icons/logo-final32.png",
    "48": "icons/logo-final48.png",
    "128": "icons/logo-final128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-final16.png",
      "32": "icons/logo-final32.png"
    },
    "default_title": "Unscamable AI"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }]
}